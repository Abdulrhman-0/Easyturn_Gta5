<Window x:Class="EasyTurn.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a color" Width="486" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#FF0A0A0A" Foreground="White" FontSize="12">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Saturation / value square + hue bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Grid x:Name="SvArea" Width="300" Height="200" ClipToBounds="True"
                  MouseLeftButtonDown="Sv_MouseLeftButtonDown"
                  MouseMove="Sv_MouseMove"
                  MouseLeftButtonUp="Sv_MouseLeftButtonUp">
                <Border x:Name="SvHueLayer" Background="#FFFF0000"/>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Ellipse x:Name="SvThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2"
                         IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Grid>

            <Grid x:Name="HueArea" Width="28" Height="200" Margin="12,0,0,0"
                  MouseLeftButtonDown="Hue_MouseLeftButtonDown"
                  MouseMove="Hue_MouseMove"
                  MouseLeftButtonUp="Hue_MouseLeftButtonUp">
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFF0000" Offset="0"/>
                            <GradientStop Color="#FFFFFF00" Offset="0.1667"/>
                            <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                            <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                            <GradientStop Color="#FF0000FF" Offset="0.6667"/>
                            <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                            <GradientStop Color="#FFFF0000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Rectangle x:Name="HueThumb" Width="28" Height="6" Stroke="White" StrokeThickness="2"
                           IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Grid>
        </StackPanel>

        <!-- Alpha (transparency) bar -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="LblAlpha" Text="Alpha"/>
            <Border Grid.Row="1" Background="#FF3A3A3A" Height="20" Margin="0,4,0,0">
                <Grid x:Name="AlphaArea"
                      MouseLeftButtonDown="Alpha_MouseLeftButtonDown"
                      MouseMove="Alpha_MouseMove"
                      MouseLeftButtonUp="Alpha_MouseLeftButtonUp">
                    <Border x:Name="AlphaGradient"/>
                    <Rectangle x:Name="AlphaThumb" Width="6" Height="20" Stroke="White" StrokeThickness="2"
                               IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Preview + hex -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="PreviewOld" Width="46" Height="34" Background="#FF3A3A3A" BorderBrush="#55FFFFFF" BorderThickness="1"/>
            <Border x:Name="PreviewNew" Grid.Column="1" Width="46" Height="34" Background="#FF0078D4" BorderBrush="#55FFFFFF" BorderThickness="1"/>
            <TextBlock x:Name="LblHex" Grid.Column="2" Text="Hex" VerticalAlignment="Center" Margin="14,0,8,0"/>
            <TextBox x:Name="TxtHex" Grid.Column="3" Background="#FF1E1E1E" Foreground="White" BorderBrush="#33FFFFFF"
                     Padding="6,4" VerticalAlignment="Center" TextChanged="Hex_TextChanged"/>
        </Grid>

        <!-- R / G / B / A numbers -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock x:Name="LblRed" Text="Red"/>
                <TextBox x:Name="TxtRed" Background="#FF1E1E1E" Foreground="White" BorderBrush="#33FFFFFF" Padding="6,4" Margin="0,4,0,0" TextChanged="Rgba_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock x:Name="LblGreen" Text="Green"/>
                <TextBox x:Name="TxtGreen" Background="#FF1E1E1E" Foreground="White" BorderBrush="#33FFFFFF" Padding="6,4" Margin="0,4,0,0" TextChanged="Rgba_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock x:Name="LblBlue" Text="Blue"/>
                <TextBox x:Name="TxtBlue" Background="#FF1E1E1E" Foreground="White" BorderBrush="#33FFFFFF" Padding="6,4" Margin="0,4,0,0" TextChanged="Rgba_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock x:Name="LblAlphaValue" Text="Alpha"/>
                <TextBox x:Name="TxtAlpha" Background="#FF1E1E1E" Foreground="White" BorderBrush="#33FFFFFF" Padding="6,4" Margin="0,4,0,0" TextChanged="Rgba_TextChanged"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOk" Content="OK" Width="100" Height="30" Click="Ok_Click"
                    Background="#FF0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="90" Height="30" Margin="10,0,0,0" Click="Cancel_Click"
                    Background="#FF2A2A2A" Foreground="#CCFFFFFF" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
