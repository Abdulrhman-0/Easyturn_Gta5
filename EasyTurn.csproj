<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>ico.ico</ApplicationIcon>

    <!-- Product metadata shown in Windows (Explorer → Properties → Details) -->
    <AssemblyTitle>EasyTurn</AssemblyTitle>
    <Product>EasyTurn</Product>
    <Description>One-click GTA 5 mod manager with vanilla file backups</Description>
    <Authors>Sensin</Authors>
    <Company>Sensin</Company>
    <Copyright>Copyright © 2026 Sensin</Copyright>
    <PackageIcon>Ico.jpg</PackageIcon>

    <!-- Version -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <!-- Keep the product version clean ("1.0.0") instead of appending the git SHA -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="ico.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Ico.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
