<Window x:Class="EasyTurn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyTurn"
        mc:Ignorable="d"
        Title="{Binding [title], Source={x:Static local:Localization.Instance}}"
        Height="620" Width="980" MinWidth="820" MinHeight="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Premium Button Style -->
        <Style x:Key="PremiumButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Premium Toggle Style: saturated blue while ON, grey while OFF -->
        <Style x:Key="PremiumToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#B0B0B0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="#3A3A3A" CornerRadius="15" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact button used inside the backup list and for secondary actions -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#330078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Body text colour, replaced at runtime from the Appearance settings -->
        <SolidColorBrush x:Key="TextColor" Color="#FFFFFFFF"/>

        <!-- Premium CheckBox Style (Green Checkmark) -->
        <Style x:Key="PremiumCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Width="20" Height="20" Background="#11FFFFFF" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Path x:Name="checkMark" Data="M 4,10 L 8,14 L 16,6" Stroke="#00FF00" StrokeThickness="2" Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="border" Property="Background" Value="#2200FF00"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00FF00"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Style -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" CornerRadius="10"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="#EE0A0A0A" CornerRadius="15" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="2"/>
        </Border.Effect>
        
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="10,5,10,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚙" Click="Settings_Click" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource TextColor}" Opacity="0.55" 
                            FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <TextBlock Text="Easy" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Turn" Foreground="#0078D4" FontSize="24" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnArgs" Content="{Binding [args], Source={x:Static local:Localization.Instance}}" 
                                  Style="{StaticResource PremiumToggleStyle}"
                                  Click="BtnArgs_Click" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,10,0"/>
                    <ToggleButton x:Name="BtnOnlineReady" 
                                  Style="{StaticResource PremiumToggleStyle}"
                                  Click="BtnOnlineReady_Click" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,10,0"/>
                    
                    <StackPanel Orientation="Horizontal">
                        <Button Content="—" Click="Minimize_Click" Style="{StaticResource WindowControlButtonStyle}"/>
                        <Button x:Name="BtnMaximize" Content="▢" Click="Maximize_Click" Style="{StaticResource WindowControlButtonStyle}"/>
                        <Button Content="✕" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" Width="34" Height="34" FontSize="14" Cursor="Hand" Background="Transparent" Foreground="#FF4444">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#EE4444"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Path Section -->
            <Border Grid.Row="1" Background="#11FFFFFF" CornerRadius="8" Padding="10" Margin="10,0,10,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtPath" Text="{Binding [pathPlaceholder], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" Opacity="0.55" 
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="{Binding [browse], Source={x:Static local:Localization.Instance}}" Click="Browse_Click" 
                            Style="{StaticResource PremiumButtonStyle}" Width="80"/>
                </Grid>
            </Border>

            <!-- Main area: mod toggles on the left, vanilla backup panel on the right -->
            <Grid Grid.Row="2" Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mod List -->
                <ScrollViewer Grid.Column="0" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ModItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0AFFFFFF" CornerRadius="5" Margin="0,0,5,5" Padding="8" Width="180">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextColor}" FontSize="12" VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,25,0"/>
                                        <CheckBox IsChecked="{Binding IsEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Style="{StaticResource PremiumCheckBoxStyle}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Vanilla files backup panel -->
                <Border Grid.Column="1" Width="330" Background="#11FFFFFF" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding [backupTitle], Source={x:Static local:Localization.Instance}}" 
                                   Foreground="{DynamicResource TextColor}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>

                        <Button Grid.Row="1" x:Name="BtnBackupVanilla" Click="BackupVanilla_Click"
                                Content="{Binding [backupButton], Source={x:Static local:Localization.Instance}}"
                                Style="{StaticResource PremiumButtonStyle}" Margin="0,8,0,8" Padding="8,6" FontSize="12"/>

                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="BackupItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0AFFFFFF" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextColor}" FontSize="13" FontWeight="Bold" 
                                                                   TextTrimming="CharacterEllipsis" Margin="0,0,70,0"/>
                                                        <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource TextColor}" Opacity="0.6" FontSize="11" 
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding FolderName}" Foreground="{DynamicResource TextColor}" Opacity="0.4" FontSize="10" 
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <Border Background="#0078D4" CornerRadius="4" Padding="6,2" Margin="0,0,4,0"
                                                                Visibility="{Binding IsNewest, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding [newest], Source={x:Static local:Localization.Instance}}" 
                                                                       Foreground="White" FontSize="10"/>
                                                        </Border>
                                                        <Border Background="#0078D4" CornerRadius="4" Padding="6,2"
                                                                Visibility="{Binding IsCurrentUsed, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding [currentUsed], Source={x:Static local:Localization.Instance}}" 
                                                                       Foreground="White" FontSize="10"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <Button Content="{Binding [openFolder], Source={x:Static local:Localization.Instance}}" 
                                                            Tag="{Binding FolderPath}" Click="OpenBackupFolder_Click"
                                                            Style="{StaticResource SmallButtonStyle}" Margin="0,6,0,0"/>
                                                    <Button Content="{Binding [copyToGame], Source={x:Static local:Localization.Instance}}" 
                                                            Tag="{Binding FolderPath}" Click="CopyFilesToGame_Click"
                                                            Style="{StaticResource SmallButtonStyle}" Margin="0,4,0,0"/>
                                                    <Button Content="{Binding [restore], Source={x:Static local:Localization.Instance}}" 
                                                            Tag="{Binding FolderPath}" Click="RestoreBackup_Click"
                                                            Style="{StaticResource SmallButtonStyle}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="TxtNoBackups" Foreground="{DynamicResource TextColor}" Opacity="0.4" FontSize="11" HorizontalAlignment="Center" 
                                       VerticalAlignment="Top" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"
                                       Text="{Binding [noBackups], Source={x:Static local:Localization.Instance}}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer / Status -->
            <Grid Grid.Row="3" Margin="0,5,0,0">
                <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextColor}" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="♥" Foreground="#FF4E8CFF" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding [madeByShort], Source={x:Static local:Localization.Instance}}" 
                               Foreground="{DynamicResource TextColor}" Opacity="0.45" FontSize="10" VerticalAlignment="Center"/>
                    <Button Content="{Binding [donate], Source={x:Static local:Localization.Instance}}" Click="Donate_Click" 
                            Style="{StaticResource SmallButtonStyle}" Margin="8,0,0,0" Padding="10,4"/>
                </StackPanel>
            </Grid>

            <!-- Settings Overlay -->
            <Grid x:Name="SettingsOverlay" Grid.Row="1" Grid.RowSpan="3" Background="#F0050505" Visibility="Collapsed" Margin="-10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                    <StackPanel>
                        <!-- Title + language selector -->
                        <Grid>
                            <TextBlock Text="{Binding [settings], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [language], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" Opacity="0.55" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbLanguage" Width="170" Height="26" SelectionChanged="Language_SelectionChanged" Background="#E6E6E6" Foreground="#111111" BorderBrush="#33FFFFFF"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#22FFFFFF" Margin="0,10,0,10"/>

                        <!-- Banned mods + online mode exclusions -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding [bannedMods], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="{Binding [bannedModsDesc], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,5"/>
                                <Border Grid.Row="2" Background="#08FFFFFF" CornerRadius="6" Padding="6" Height="190">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="BannedControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextColor}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,26,0"/>
                                                        <CheckBox IsChecked="{Binding IsBanned}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PremiumCheckBoxStyle}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding [onlineExclusions], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="{Binding [onlineExclusionsDesc], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" Opacity="0.55" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,5"/>
                                <Border Grid.Row="2" Background="#08FFFFFF" CornerRadius="6" Padding="6" Height="190">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="ExclusionsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextColor}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,26,0"/>
                                                        <CheckBox IsChecked="{Binding IsExcluded}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PremiumCheckBoxStyle}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>

                        <TextBlock Text="{Binding [gameFilesNote], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" Opacity="0.4" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <Border Height="1" Background="#22FFFFFF" Margin="0,10,0,10"/>

                        <!-- Appearance -->
                        <TextBlock Text="{Binding [appearance], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" FontSize="15" FontWeight="Bold"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding [fontColor], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" Opacity="0.8" FontSize="12" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="BtnPickFontColor" Click="PickFontColor_Click" HorizontalAlignment="Left" Padding="12,5" Background="#1FFFFFFF" Foreground="White" BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="FontColorSwatch" Width="20" Height="20" CornerRadius="3" BorderBrush="#66FFFFFF" BorderThickness="1" Background="#FFFFFFFF"/>
                                    <TextBlock x:Name="TxtFontColorHex" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Row="1" Text="{Binding [backgroundColor], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" Opacity="0.8" FontSize="12" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <Button Grid.Row="1" Grid.Column="1" x:Name="BtnPickColor" Click="PickColor_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,5" Background="#1FFFFFFF" Foreground="White" BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="ColorSwatch" Width="20" Height="20" CornerRadius="3" BorderBrush="#66FFFFFF" BorderThickness="1" Background="#FF0A0A0A"/>
                                    <TextBlock x:Name="TxtColorHex" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Row="2" Text="{Binding [transparency], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" Opacity="0.8" FontSize="12" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <Slider x:Name="SldOpacity" Width="240" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Opacity_ValueChanged"/>
                                <TextBlock x:Name="TxtOpacityValue" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" FontSize="11" MinWidth="40"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Text="{Binding [blur], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" Opacity="0.8" FontSize="12" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <Slider x:Name="SldBlur" Width="240" Minimum="0" Maximum="60" VerticalAlignment="Center" ValueChanged="Blur_ValueChanged"/>
                                <TextBlock x:Name="TxtBlurValue" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" FontSize="11" MinWidth="40"/>
                                <Button Content="{Binding [resetAppearance], Source={x:Static local:Localization.Instance}}" Click="ResetAppearance_Click" Style="{StaticResource SmallButtonStyle}" Margin="10,0,0,0" Padding="12,5"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#22FFFFFF" Margin="0,10,0,10"/>

                        <!-- Extra Game Arguments Section -->
                        <TextBlock Text="{Binding [gameArgs], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" FontSize="15" FontWeight="Bold"/>
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding [gameArgsDesc], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" Opacity="0.55" FontSize="11" TextWrapping="Wrap"/>
                            <TextBox x:Name="TxtGameArgs" Background="#11FFFFFF" Foreground="{DynamicResource TextColor}" BorderBrush="#33FFFFFF" TextWrapping="NoWrap" Padding="8" FontSize="13" Margin="0,5,0,0"/>
                        </StackPanel>

                        <Border Height="1" Background="#22FFFFFF" Margin="0,10,0,10"/>

                        <!-- Custom Mods Configuration Section -->
                        <TextBlock Text="{Binding [customMods], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" FontSize="15" FontWeight="Bold"/>
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding [customModsDesc], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" Opacity="0.55" FontSize="11" TextWrapping="Wrap"/>
                            <TextBox x:Name="TxtCustomMods" Background="#11FFFFFF" Foreground="{DynamicResource TextColor}" BorderBrush="#33FFFFFF" AcceptsReturn="True" TextWrapping="NoWrap" Padding="8" FontSize="13" Height="70" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0"/>
                        </StackPanel>

                        <Border Height="1" Background="#22FFFFFF" Margin="0,10,0,10"/>

                        <!-- About -->
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [madeBy], Source={x:Static local:Localization.Instance}}" Foreground="{DynamicResource TextColor}" Opacity="0.8" FontSize="12" HorizontalAlignment="Center"/>
                            <Button Content="{Binding [donate], Source={x:Static local:Localization.Instance}}" Click="Donate_Click" Style="{StaticResource PremiumButtonStyle}" Width="150" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="{Binding [saveClose], Source={x:Static local:Localization.Instance}}" Click="SaveSettings_Click" Style="{StaticResource PremiumButtonStyle}" Width="140"/>
                            <Button Content="{Binding [cancel], Source={x:Static local:Localization.Instance}}" Click="CancelSettings_Click" Style="{StaticResource SmallButtonStyle}" Width="90" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>